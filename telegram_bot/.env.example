# Telegram bot token from @BotFather (create a bot with /newbot)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your numeric Telegram user id. Leave blank on first run — message the bot
# once and it will tell you your id and where to paste it.
TELEGRAM_ALLOWED_USER_ID=

# Path to the Claude Code CLI binary. If `claude` is on PATH, leave as-is.
CLAUDE_BIN=claude

# Directory the CLI runs from — must be this repo so it picks up
# .claude/agents and the clio-toolkit plugin. Defaults to this folder's
# parent if unset.
CLAUDE_PROJECT_DIR=..

# Optional: pin a specific model (defaults to the CLI's own default).
CLAUDE_MODEL=

# Max time (ms) to wait for one Claude turn before giving up. Agent-routed
# turns that write to Clio can legitimately take several minutes, so this
# should have real headroom — 1800000 (30 min) is a reasonable floor. This is
# long-polling (no Telegram webhook deadline), so there's no upstream limit
# forcing this to stay short.
CLAUDE_TIMEOUT_MS=1800000

# Maton API key — this is what the clio-toolkit skills actually authenticate
# with (gateway.maton.ai), not a Clio-issued token. Get/reset it at
# maton.ai/settings. Required for any Clio-backed agent to work.
MATON_API_KEY=

# Optional: only needed if you have more than one Clio connection under this
# Maton account. Found at ctrl.maton.ai.
CLIO_CONNECTION_ID=
