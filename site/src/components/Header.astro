---
import { site, nav } from '../siteData';

// Mark the current page for aria-current styling.
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  (href.replace(/\/+$/, '') || '/') === current;
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="6170 Properties — home">
      <svg
        class="brand-mark"
        viewBox="0 0 120 74"
        aria-hidden="true"
        focusable="false"
        fill="none"
        stroke="currentColor"
        stroke-width="4"
        stroke-linecap="square"
      >
        <path d="M6 52 L60 14 L114 52" />
        <path d="M2 55 H16" />
        <path d="M104 55 H118" />
        <path d="M80 30 V20 H90 V40" />
      </svg>
      <span class="brand-word">6170 Properties</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
