---
// Renders a team section only if src/content/team/*.md files exist.
// With no files, this outputs nothing at all. Add a Markdown file per person
// (frontmatter: name, optional role, optional order) to populate it — no code
// changes needed. See src/content/team/HOW-TO-ADD-TEAM.txt.
interface TeamFrontmatter {
  name: string;
  role?: string;
  order?: number;
}

const modules = import.meta.glob<{
  frontmatter: TeamFrontmatter;
  Content: any;
}>('../content/team/*.md', { eager: true });

const members = Object.values(modules)
  .map((m) => ({ data: m.frontmatter, Content: m.Content }))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

{
  members.length > 0 && (
    <section class="section" aria-labelledby="team-heading">
      <h2 id="team-heading">Our team</h2>
      <div class="cards">
        {members.map(({ data, Content }) => (
          <div class="card">
            <h3>{data.name}</h3>
            {data.role && <p class="hint">{data.role}</p>}
            <Content />
          </div>
        ))}
      </div>
    </section>
  )
}
