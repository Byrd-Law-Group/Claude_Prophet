---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, hasMailingAddress, hasPhone } from '../siteData';

const entry = await getEntry('pages', 'contact');
if (!entry) throw new Error('Missing content: src/content/pages/contact.md');
const { title, description } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container prose">
      <Content />

      <h2>Our details</h2>
      <address class="footer-legal">
        <strong>{site.legalName}</strong><br />
        {site.entityLine}<br />
        {hasMailingAddress && <>{site.mailingAddress}<br /></>}
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {hasPhone && (
          <>
            <br />
            <a href={`tel:${site.phone}`}>{site.phone}</a>
          </>
        )}
      </address>

      <h2>Send us a message</h2>
      <ContactForm variant="contact" formName="Contact form" />
    </div>
  </section>
</BaseLayout>
