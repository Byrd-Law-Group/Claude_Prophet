---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../siteData';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing content: src/content/pages/home.md');
const { title, description, hero, blocks, whoWeAre } = entry.data;

// JSON-LD LocalBusiness / RealEstateAgent schema for the home page.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: site.legalName,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  image: new URL('/og-image.png', site.url).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.mailingAddress,
    addressRegion: 'OH',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: site.areaServed,
  },
};
---

<BaseLayout title={title} description={description}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    is:inline
  />

  <section class="hero">
    <div class="container">
      <h1>{hero?.heading}</h1>
      <p class="statement">{hero?.statement}</p>
      <div class="hero-actions">
        {
          hero?.ctas.map((cta) => (
            <a
              class={`btn ${cta.variant === 'primary' ? 'btn-primary' : 'btn-secondary'}`}
              href={cta.href}
            >
              {cta.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-label="What we do">
    <div class="container">
      <div class="cards">
        {
          blocks?.map((block) => (
            <div class="card">
              <h2 style="font-size:1.25rem;margin-top:0;">{block.heading}</h2>
              <p>{block.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    whoWeAre && (
      <section class="section" aria-labelledby="who-we-are">
        <div class="container prose">
          <h2 id="who-we-are">{whoWeAre.heading}</h2>
          <p>{whoWeAre.body}</p>
          <p>
            <a href={whoWeAre.linkHref}>{whoWeAre.linkLabel}</a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>
