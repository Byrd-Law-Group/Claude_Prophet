---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { marked } from '../lib/inline-md';

const entry = await getEntry('pages', 'foreclosures');
if (!entry) throw new Error('Missing content: src/content/pages/foreclosures.md');
const { title, description, afterFormNote } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container prose">
      <Content />

      <ContactForm variant="owners" formName="Foreclosure inquiry" />

      {
        afterFormNote && (
          <div class="card" style="margin-top:2rem;">
            <p set:html={marked(afterFormNote)} />
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
