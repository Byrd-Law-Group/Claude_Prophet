# Environment variables for the contact form (Cloudflare Pages Function).
# These are set in the Cloudflare Pages project (Settings -> Environment
# variables), NOT committed. Copy to `.dev.vars` for local function testing
# with `wrangler pages dev`.

# Resend API key — https://resend.com (Account -> API Keys)
RESEND_API_KEY=

# Where form submissions are emailed
CONTACT_TO=team@6170properties.com

# Cloudflare Turnstile secret key (server side).
# The matching *site* key is public and goes in src/siteData.ts.
TURNSTILE_SECRET=

# Optional: verified Resend sender. Must be on a domain you verified in Resend.
# CONTACT_FROM=6170 Properties <website@6170properties.com>
