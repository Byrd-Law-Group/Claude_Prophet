# Cloudflare Pages headers. Applied to all routes.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Content-Security-Policy locks down what the browser may load. The ONLY
  # permitted third parties are Cloudflare Turnstile (form anti-spam) and, if
  # enabled, cookieless Cloudflare Web Analytics. 'unsafe-inline' script is
  # required for our small inline scripts (JSON-LD + the no-framework form
  # handler); the site is static and reflects no user input into HTML.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com
