# Tax-Lien Acquisition Pipeline — Twilio + caller identity
# Copy relevant lines into the repo-root .env (do NOT commit real secrets).

# Twilio (only needed to actually send SMS / place calls)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1937XXXXXXX
INVESTOR_PHONE_NUMBER=+1937XXXXXXX

# Caller identity — REQUIRED by TCPA / Ohio law. No spoofing, no impersonation.
CALLER_NAME=Your Name
COMPANY_NAME=Your Company
CALLBACK_NUMBER=+1937XXXXXXX

# DNC scrubbing vendor — The Blacklist Alliance (https://www.blacklistalliance.com/).
# Without a key, every number stays 'unknown' -> mail_only until you record a
# consent basis. With a key, numbers are scrubbed against DNC + litigator lists.
BLACKLIST_API_KEY=your_blacklist_alliance_api_key
# BLACKLIST_API_URL=https://api.blacklistalliance.net/lookup   # override if your account differs

# Optional: override the leads database path
# TLP_DB_PATH=/absolute/path/to/leads.db
